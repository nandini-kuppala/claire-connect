{
  "name": "@claire/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "tsx src/index.ts",
    "seed": "tsx src/db/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 'src/**/*.test.ts' '../shared/sc/**/*.test.ts'",
    "sc:flag": "tsx src/sc/flag-cli.ts",
    "sc:verify": "tsx src/sc/verify.ts",
    "sc:migrate-orders": "tsx src/sc/migrate-cli.ts",
    "sc:demo-reset": "tsx src/sc/demo-reset-cli.ts",
    "sc:claire-fixtures": "tsx src/sc/claire/fixtures.mts",
    "sc:claire-smoke": "tsx src/sc/claire/smoke.mts",
    "chat:moderation": "tsx src/chatops/moderation-cli.ts",
    "chat:archive": "tsx src/chatops/archive-cli.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^4.22.3",
    "mongodb": "^7.9.0",
    "multer": "^2.5.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "typescript": "5.9"
  },
  "engines": {
    "node": ">=22"
  }
}
