# ── CLAIRE Connect server secrets ─────────────────────────────
# Copy this file to server/.env and paste your values. Never commit .env.

# Nexconn Console → Key Management (https://console.nexconn.ai/agile/apps/km)
NEXCONN_APP_KEY=
NEXCONN_APP_SECRET=
# Data center shown on the same page: SG (Singapore), NA (North America) or SA (Saudi Arabia)
NEXCONN_AREA=SG

# OpenRouter key (openrouter.ai → Keys). Variable name "openrouter" or OPENROUTER_API_KEY both work.
OPENROUTER_API_KEY=
# MongoDB Atlas connection string (Atlas → Connect → Drivers). Database name defaults to "nexconn".
MONGODB_URI=
# Local work uses the dev database; production sets MONGODB_DB=nexconn in render.yaml.
MONGODB_DB=nexconn_sc_dev

# Sarvam AI key for Indian-language speech-to-text / text-to-speech (indus.sarvam.ai/key-management → create key)
SARVAM_API_KEY=

# Optional OpenRouter tuning (comma lists allowed; free tier is ~20 req/min, 1000 req/day)
# OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# OPENROUTER_VISION_MODEL=nvidia/nemotron-3.5-super-vl:free
# OPENROUTER_RPM=19
# OPENROUTER_RPD=1000

# Server settings. Locally leave as is. In production set both URLs to your public https URL
# (e.g. https://claire-connect.onrender.com) and use a long random JWT_SECRET.
PORT=8787
PUBLIC_WEB_URL=http://localhost:5173
PUBLIC_SERVER_URL=http://localhost:8787
JWT_SECRET=change-me-local-dev-secret
# Demo OTP accepted for every phone number (there is no SMS provider)
DEMO_OTP=123456
