{
  "name": "claire-connect",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"npm run dev -w server\" \"npm run dev -w web\"",
    "seed": "npm run seed -w server",
    "build": "npm run build -w web",
    "start": "npm run start -w server",
    "typecheck": "tsc --noEmit -p server && tsc --noEmit -p web"
  },
  "devDependencies": {
    "concurrently": "^9.2.5"
  },
  "engines": {
    "node": ">=22"
  }
}
